package Sintactico;

import java_cup.runtime.Symbol;
import java.util.ArrayList;
import java.util.List;
import Semantico.*;

parser code {:
    private final List<String> erroresSintacticos = new ArrayList<>();
    private final List<String> erroresSemanticos = new ArrayList<>();

    private final SymbolTableManager tablaSimbolos = new SymbolTableManager();

    private SymbolInfo currentFunction = null;
    private int blockCounter = 0;

    public List<String> getErroresSintacticos() {
        return erroresSintacticos;
    }

    public List<String> getErroresSemanticos() {
        return erroresSemanticos;
    }

    public boolean tieneErrores() {
        return !erroresSintacticos.isEmpty() || !erroresSemanticos.isEmpty();
    }

    public boolean tieneErroresSemanticos() {
        return !erroresSemanticos.isEmpty();
    }

    public SymbolTableManager getTablaSimbolos() {
        return tablaSimbolos;
    }

    private String nombreFuncionActual() {
    return currentFunction != null ? currentFunction.getLexeme() : "<desconocida>";
    }

    private int lineaFuncionActual() {
        return currentFunction != null ? currentFunction.getLine() : -1;
    }

    /**
    * Convierte el código numérico de un token a su nombre legible.
    *
    * @param tok Token del cual se quiere obtener el nombre.
    * @return Nombre del token, o "EOF" si el token es null.
    */
    private String nombreToken(Symbol tok) {
        if (tok == null) return "EOF";
        try {
            return sym.terminalNames[tok.sym];
        } catch (Exception e) {
            return "SYM(" + tok.sym + ")";
        }
    }
    
    /**
    * Retorna el lexema de un token. Si el token no tiene valor semántico,
    * retorna su nombre como fallback.
    *
    * @param tok Token del cual se quiere obtener el lexema.
    * @return Lexema del token, o su nombre si no tiene valor.
    */
    private String lexemaToken(Symbol tok) {
        if (tok == null) return "<EOF>";
        return tok.value != null ? tok.value.toString() : nombreToken(tok);
    }

    /**
    * Registra un error semántico en la lista de errores.
    *
    * @param mensaje Descripción del error semántico encontrado.
    */
    private void errorSemantico(String mensaje) {
        erroresSemanticos.add(mensaje);
    }

    /**
    * Registra una función o procedimiento en la tabla de símbolos global
    * y abre un nuevo scope con su nombre.
    * Si la función ya fue declarada, reporta un error semántico.
    *
    * @param name       Nombre de la función o procedimiento.
    * @param returnType Tipo de retorno de la función.
    * @param line       Línea de declaración en el archivo fuente.
    * @param col        Columna de declaración en el archivo fuente.
    * @param isMain     true si es el procedimiento principal __main__.
    */
    private void declararFuncion(String name, DataType returnType, int line, int col, boolean isMain) {
        SymbolInfo info = new SymbolInfo(
                name,
                isMain ? SymbolKind.MAIN : SymbolKind.FUNCTION,
                isMain ? DataType.EMPTY : returnType,
                line,
                col,
                "global",
                0
        );

        boolean inserted = tablaSimbolos.insertIntoGlobal(info);
        if (!inserted) {
            errorSemantico(
                "Error semántico: redeclaración de función/procedimiento '" + name +
                "' en línea " + line + ", columna " + col
            );
            currentFunction = tablaSimbolos.lookupGlobal(name);
        } else {
            currentFunction = info;
        }

        tablaSimbolos.enterScope(name);
    }

    /**
    * Cierra el scope de la función actual y limpia la referencia a la función activa.
    */
    private void cerrarFuncion() {
        currentFunction = null;
        tablaSimbolos.exitScope();
    }

    /**
    * Registra los parámetros de una función en el scope actual y los agrega
    * a la firma de la función activa.
    * Reporta error semántico si algún parámetro está redeclarado.
    *
    * @param params Lista de ParameterInfo con los parámetros a registrar.
    */
    private void registrarParametros(ArrayList params) {
        if (params == null) return;

        for (Object obj : params) {
            ParameterInfo p = (ParameterInfo) obj;

            SymbolInfo s = new SymbolInfo(
                    p.getName(),
                    SymbolKind.PARAMETER,
                    p.getType(),
                    p.getLine(),
                    p.getColumn(),
                    tablaSimbolos.currentScope().getName(),
                    tablaSimbolos.currentScope().getLevel()
            );
            s.setInitialized(true);

            boolean inserted = tablaSimbolos.insert(s);
            if (!inserted) {
                errorSemantico(
                    "Error semántico: parámetro redeclarado '" + p.getName() +
                    "' en línea " + p.getLine() + ", columna " + p.getColumn()
                );
            }

            if (currentFunction != null) {
                currentFunction.addParameter(p.getName(), p.getType());
            }
        }
    }

    /**
    * Registra un identificador (variable o arreglo) en el scope actual.
    * Reporta error semántico si el identificador ya fue declarado en el mismo scope.
    *
    * @param name Nombre del identificador.
    * @param type Tipo de dato del identificador.
    * @param tail Información del sufijo de la declaración (escalar o arreglo, inicializado o no).
    * @param line Línea de declaración en el archivo fuente.
    * @param col  Columna de declaración en el archivo fuente.
    */
    private void declararIdentificador(String name, DataType type, DeclTailInfo tail, int line, int col) {
        SymbolKind kind = tail.isArray() ? SymbolKind.ARRAY : SymbolKind.VARIABLE;

        SymbolInfo info = new SymbolInfo(
                name,
                kind,
                type,
                line,
                col,
                tablaSimbolos.currentScope().getName(),
                tablaSimbolos.currentScope().getLevel()
        );

        info.setInitialized(tail.isInitialized());

        if (tail.isArray()) {
            info.setDimensions(tail.getDim1(), tail.getDim2());
        }

        boolean inserted = tablaSimbolos.insert(info);
        if (!inserted) {
            errorSemantico(
                "Error semántico: identificador redeclarado '" + name +
                "' en línea " + line + ", columna " + col +
                " dentro del scope '" + tablaSimbolos.currentScope().getName() + "'"
            );
        }
    }

    /**
    * Verifica que un identificador usado en el código haya sido declarado previamente
    * y que sea una variable o parámetro (no función ni arreglo sin índices).
    * Marca el símbolo como usado si la verificación es exitosa.
    *
    * @param name Nombre del identificador referenciado.
    * @param line Línea de uso en el archivo fuente.
    * @param col  Columna de uso en el archivo fuente.
    */
    private void usarVariable(String name, int line, int col) {
        SymbolInfo s = tablaSimbolos.lookup(name);

        if (s == null) {
            errorSemantico(
                "Error semántico: identificador no declarado '" + name +
                "' en línea " + line + ", columna " + col
            );
            return;
        }

        if (s.getKind() == SymbolKind.FUNCTION || s.getKind() == SymbolKind.MAIN) {
            errorSemantico(
                "Error semántico: '" + name +
                "' es una función/procedimiento y no una variable en línea " + line + ", columna " + col
            );
            return;
        }

        if (s.getKind() == SymbolKind.ARRAY) {
            errorSemantico(
                "Error semántico: el arreglo '" + name +
                "' requiere índices en línea " + line + ", columna " + col
            );
            return;
        }

        s.setUsed(true);
    }

    /**
    * Verifica que un arreglo usado en el código haya sido declarado previamente
    * y que efectivamente sea de tipo ARRAY.
    * Marca el símbolo como usado si la verificación es exitosa.
    *
    * @param name Nombre del arreglo referenciado.
    * @param line Línea de uso en el archivo fuente.
    * @param col  Columna de uso en el archivo fuente.
    */
    private void usarArreglo(String name, int line, int col) {
        SymbolInfo s = tablaSimbolos.lookup(name);

        if (s == null) {
            errorSemantico(
                "Error semántico: arreglo no declarado '" + name +
                "' en línea " + line + ", columna " + col
            );
            return;
        }

        if (s.getKind() != SymbolKind.ARRAY) {
            errorSemantico(
                "Error semántico: '" + name +
                "' no es un arreglo en línea " + line + ", columna " + col
            );
            return;
        }

        s.setUsed(true);
    }

    /**
    * Verifica que una función o procedimiento llamado en el código haya sido
    * declarado previamente en el scope global.
    * Marca el símbolo como usado si la verificación es exitosa.
    *
    * @param name Nombre de la función referenciada.
    * @param line Línea de uso en el archivo fuente.
    * @param col  Columna de uso en el archivo fuente.
    */
    private void usarFuncion(String name, int line, int col) {
        SymbolInfo s = tablaSimbolos.lookupGlobal(name);

        if (s == null) {
            errorSemantico(
                "Error semántico: función/procedimiento no declarado '" + name +
                "' en línea " + line + ", columna " + col
            );
            return;
        }

        if (s.getKind() != SymbolKind.FUNCTION && s.getKind() != SymbolKind.MAIN) {
            errorSemantico(
                "Error semántico: '" + name +
                "' no es una función/procedimiento en línea " + line + ", columna " + col
            );
            return;
        }

        s.setUsed(true);
    }

    /**
    * Abre un nuevo scope anónimo para un bloque de código sin nombre de función.
    * El nombre del scope se genera automáticamente como "block_N".
    */
    private void entrarBloqueAnonimo() {
        blockCounter++;
        tablaSimbolos.enterScope("block_" + blockCounter);
    }

    /**
    * Cierra el scope actualmente activo retirándolo de la pila.
    */
    private void salirScope() {
        tablaSimbolos.exitScope();
    }

    /**
    * Maneja los errores sintácticos detectados por CUP durante el parsing.
    * Registra el error con línea, columna y token encontrado, y continúa el análisis.
    *
    * @param cur_token Token donde se detectó el error sintáctico.
    */
    @Override
    public void syntax_error(Symbol cur_token) {
        String mensaje =
                "Error sintáctico en línea " + (cur_token != null ? cur_token.left : -1) +
                ", columna " + (cur_token != null ? cur_token.right : -1) +
                ". Token encontrado: " + nombreToken(cur_token) +
                " (" + lexemaToken(cur_token) + ")";
        erroresSintacticos.add(mensaje);
    }

    /**
    * Maneja los errores sintácticos de los que CUP no pudo recuperarse.
    * Registra el error y detiene el parsing con done_parsing().
    *
    * @param cur_token Token donde falló la recuperación.
    * @throws Exception Si no fue posible continuar el análisis.
    */
    @Override
    public void unrecovered_syntax_error(Symbol cur_token) throws Exception {
        String mensaje =
                "Recuperación fallida en línea " + (cur_token != null ? cur_token.left : -1) +
                ", columna " + (cur_token != null ? cur_token.right : -1) +
                ". No fue posible continuar desde: " + nombreToken(cur_token) +
                " (" + lexemaToken(cur_token) + ")";
        erroresSintacticos.add(mensaje);
        done_parsing();
    }

    /**
    * Reporta un error de recuperación a nivel de frase.
    * Se usa cuando el parser detecta un error específico y predecible,
    * como la falta del terminador '!' al final de una sentencia.
    *
    * @param mensaje Descripción del error detectado.
    * @param linea   Línea exacta donde ocurrió el error.
    */
    private void reportarErrorFrase(String mensaje, int linea) {
        String msg = "Error de frase en línea " + linea + ": " + mensaje;
        erroresSintacticos.add(msg);
        System.out.println(msg);
    }

    private boolean tiposCompatibles(DataType destino, DataType origen) {
        if (destino == origen) return true;
        // INT y SCIENTIFIC son compatibles entre si
        if (destino == DataType.INT && origen == DataType.SCIENTIFIC) return true;
        if (destino == DataType.SCIENTIFIC && origen == DataType.INT) return true;
        // INT y FRAC son compatibles
        if (destino == DataType.INT && origen == DataType.FRAC) return true;
        if (destino == DataType.FRAC && origen == DataType.INT) return true;
        if (destino == DataType.FLOAT && origen == DataType.INT) return true;
            return false;
    }

:};

terminal INT_T, FLOAT_T, BOOL_T, CHAR_T, STRING_T, SCIENTIFIC_T, FRAC_T, EMPTY_T;
terminal IF, ELSE, DO, WHILE, SWITCH, CASE, DEFAULT, RETURN, BREAK, CIN, COUT;
terminal TRUE, FALSE, MAIN;
terminal EQUAL, N_EQUAL, LESS_T, LESS_TE, GREATHER_T, GREATHER_TE;
terminal TILDE, ASSIGN, PIPE_L, PIPE_R, BLOCK_OPEN, BLOCK_CLOSE, INDEX_OPEN, INDEX_CLOSE, BANG, COMMA;
terminal PLUS, MINUS, TIMES, DIV, MOD, POW, INC, DEC, AND, OR, NOT;
terminal String IDENTIFIER, INTEGER_LITERAL, FLOAT_LITERAL, SCIENTIFIC_LITERAL, FRACTION_LITERAL, CHAR_LITERAL, STRING_LITERAL;

non terminal program;
non terminal function_prefix, function_suffix, function_decl, main_procedure;
non terminal function_decl_rest, main_rest;

non terminal java.util.ArrayList parameter_block_opt, parameter_list, parameter_tail;

non terminal block, block_items, block_item;
non terminal statement;

non terminal declaration_stmt, typed_decl;
non terminal assign_stmt;

non terminal DataType lvalue;

non terminal DataType array_access;

non terminal matrix_literal, row_list, row_tail, row_literal, cell_list, cell_tail;
non terminal argument_block_opt, argument_list, argument_tail;

non terminal DataType call_expr;

non terminal read_stmt, read_target, write_stmt, output_list, output_tail, output_value;
non terminal if_stmt, else_opt, do_while_stmt, switch_stmt, switch_body, case_list, case_section, default_opt, case_constant;
non terminal return_stmt, break_stmt;

non terminal DataType expression, condition;
non terminal DataType reference_expr;

non terminal DataType bool_expr, bool_chain, bool_chain_tail, conj_term, conj_term_tail, bool_unit, bool_atom, rel_expr, eq_operand, bool_literal;
non terminal DataType num_expr, sum_stage, sum_tail, prod_stage, prod_tail, power_stage, prefix_stage, num_atom, incrementable, negative_literal, numeric_literal;
non terminal DataType string_expr, char_expr;

non terminal DataType return_type, data_type, non_array_type;
non terminal ParameterInfo parameter;
non terminal DeclTailInfo int_decl_tail, float_decl_tail, other_decl_tail;
non terminal Boolean array_init_opt;
non terminal block_body;
non terminal block_enter;

start with program;

program ::= function_prefix main_procedure function_suffix ;

function_prefix ::= function_decl function_prefix
                  | /* empty */
                  ;

function_suffix ::= function_decl function_suffix
                  | /* empty */
                  ;

function_decl ::= return_type:rt TILDE IDENTIFIER:id
                  {:
                      declararFuncion(id, rt, idleft, idright, false);
                  :}
                  function_decl_rest
                  {:
                      cerrarFuncion();
                  :}
                  ;

function_decl_rest ::= PIPE_L parameter_block_opt:params PIPE_R
                       {:
                           registrarParametros(params);
                       :}
                       block
                     | error PIPE_R block
                       {:
                           reportarErrorFrase(
                               "Encabezado inválido de la función '" + nombreFuncionActual() +
                               "'. Se continuó desde el bloque de la función.",
                               lineaFuncionActual()
                           );
                       :}
                     ;

main_procedure ::= EMPTY_T TILDE MAIN:m
                   {:
                       declararFuncion("__main__", DataType.EMPTY, mleft, mright, true);
                   :}
                   main_rest
                   {:
                       cerrarFuncion();
                   :}
                   ;

main_rest ::= PIPE_L PIPE_R block
            | error PIPE_R block
              {:
                  reportarErrorFrase(
                      "Encabezado inválido de __main__. Se continuó desde el bloque principal.",
                      lineaFuncionActual()
                  );
              :}
            ;

return_type ::= INT_T    {: RESULT = DataType.INT; :}
              | FLOAT_T  {: RESULT = DataType.FLOAT; :}
              | CHAR_T   {: RESULT = DataType.CHAR; :}
              | BOOL_T   {: RESULT = DataType.BOOL; :}
              ;

data_type ::= INT_T         {: RESULT = DataType.INT; :}
            | FLOAT_T       {: RESULT = DataType.FLOAT; :}
            | BOOL_T        {: RESULT = DataType.BOOL; :}
            | CHAR_T        {: RESULT = DataType.CHAR; :}
            | STRING_T      {: RESULT = DataType.STRING; :}
            | SCIENTIFIC_T  {: RESULT = DataType.SCIENTIFIC; :}
            | FRAC_T        {: RESULT = DataType.FRAC; :}
            ;

parameter_block_opt ::= parameter_list:p
                        {: RESULT = p; :}
                      | /* empty */
                        {: RESULT = new java.util.ArrayList(); :}
                      ;

parameter_list ::= parameter:p parameter_tail:t
                   {:
                       t.add(0, p);
                       RESULT = t;
                   :}
                 ;

parameter_tail ::= COMMA parameter:p parameter_tail:t
                   {:
                       t.add(0, p);
                       RESULT = t;
                   :}
                 | /* empty */
                   {: RESULT = new java.util.ArrayList(); :}
                 ;

parameter ::= data_type:t TILDE IDENTIFIER:id
              {: RESULT = new ParameterInfo(id, t, idleft, idright); :}
              ;

block ::= BLOCK_OPEN block_enter block_body BLOCK_CLOSE
          {: salirScope(); :}
        ;

block_enter ::= 
          {: entrarBloqueAnonimo(); :}
        ;

block_body ::= block_items
             | error
        ;

block_items ::= block_item block_items
              | /* empty */
              ;

block_item ::= statement ;

statement ::= declaration_stmt BANG
            | assign_stmt BANG
            | num_expr BANG
            | bool_expr BANG
            | string_expr BANG
            | char_expr BANG
            | if_stmt
            | do_while_stmt
            | switch_stmt
            | read_stmt BANG
            | write_stmt BANG
            | return_stmt BANG
            | break_stmt BANG
            | block
            | error BANG
            ;

declaration_stmt ::= typed_decl ;

typed_decl ::= INT_T TILDE IDENTIFIER:id int_decl_tail:t
               {:
                   declararIdentificador(id, DataType.INT, t, idleft, idright);
                   if (t.getExprType() != null && !tiposCompatibles(DataType.INT, t.getExprType())) {
                       errorSemantico(
                           "Error semántico: tipos incompatibles en declaración de '" + id +
                           "', se esperaba INT pero se encontró " + t.getExprType() +
                           " en línea " + idleft
                       );
                   }
               :}
             | FLOAT_T TILDE IDENTIFIER:id float_decl_tail:t
               {:
                   declararIdentificador(id, DataType.FLOAT, t, idleft, idright);
                   if (t.getExprType() != null && !tiposCompatibles(DataType.FLOAT, t.getExprType())) {
                       errorSemantico(
                           "Error semántico: tipos incompatibles en declaración de '" + id +
                           "', se esperaba FLOAT pero se encontró " + t.getExprType() +
                           " en línea " + idleft
                       );
                   }
               :}
             | non_array_type:tp TILDE IDENTIFIER:id other_decl_tail:t
               {:
                   declararIdentificador(id, tp, t, idleft, idright);
                   if (t.getExprType() != null && !tiposCompatibles(tp, t.getExprType())) {
                       errorSemantico(
                           "Error semántico: tipos incompatibles en declaración de '" + id +
                           "', se esperaba " + tp + " pero se encontró " + t.getExprType() +
                           " en línea " + idleft
                       );
                   }
               :}
             ;

non_array_type ::= BOOL_T        {: RESULT = DataType.BOOL; :}
                 | CHAR_T        {: RESULT = DataType.CHAR; :}
                 | STRING_T      {: RESULT = DataType.STRING; :}
                 | SCIENTIFIC_T  {: RESULT = DataType.SCIENTIFIC; :}
                 | FRAC_T        {: RESULT = DataType.FRAC; :}
                 ;

other_decl_tail ::= ASSIGN expression:e
                    {: RESULT = DeclTailInfo.scalar(true, e); :}
                  | /* empty */
                    {: RESULT = DeclTailInfo.scalar(false, null); :}
                  ;

int_decl_tail ::= ASSIGN expression:e
                  {: RESULT = DeclTailInfo.scalar(true, e); :}
                | INDEX_OPEN INTEGER_LITERAL:d1 COMMA INTEGER_LITERAL:d2 INDEX_CLOSE array_init_opt:init
                  {: RESULT = DeclTailInfo.array(Integer.parseInt(d1), Integer.parseInt(d2), init.booleanValue()); :}
                | /* empty */
                  {: RESULT = DeclTailInfo.scalar(false, null); :}
                ;

float_decl_tail ::= ASSIGN expression:e
                    {: RESULT = DeclTailInfo.scalar(true,e); :}
                  | INDEX_OPEN INTEGER_LITERAL:d1 COMMA INTEGER_LITERAL:d2 INDEX_CLOSE array_init_opt:init
                    {: RESULT = DeclTailInfo.array(Integer.parseInt(d1), Integer.parseInt(d2), init.booleanValue()); :}
                  | /* empty */
                    {: RESULT = DeclTailInfo.scalar(false,null); :}
                  ;

array_init_opt ::= ASSIGN matrix_literal
                   {: RESULT = Boolean.TRUE; :}
                 | /* empty */
                   {: RESULT = Boolean.FALSE; :}
                 ;

assign_stmt ::= lvalue:lv ASSIGN expression:e
                {:
                    System.out.println("DEBUG assign: lv=" + lv + " e=" + e);
                    if (lv != null && e != null && lv != DataType.UNKNOWN && e != DataType.UNKNOWN) {
                        if (!tiposCompatibles(lv, e)) {
                            errorSemantico(
                                "Error semántico: tipos incompatibles en asignación, " +
                                "se esperaba " + lv + " pero se encontró " + e +
                                " en línea " + lvleft
                            );
                        }
                    }
                :}
              ;

lvalue ::= IDENTIFIER:id
           {:
               usarVariable(id, idleft, idright);
               SymbolInfo s = tablaSimbolos.lookup(id);
               RESULT = s != null ? s.getType() : DataType.UNKNOWN;
           :}
         | array_access:a
           {: RESULT = a; :}
         ;

array_access ::= IDENTIFIER:id
                 {:
                     usarArreglo(id, idleft, idright);
                 :}
                 INDEX_OPEN num_expr COMMA num_expr INDEX_CLOSE
                 {:
                     SymbolInfo s = tablaSimbolos.lookup(id);
                     RESULT = s != null ? s.getType() : DataType.UNKNOWN;
                 :}
                 ;

matrix_literal ::= BLOCK_OPEN row_list BLOCK_CLOSE ;

row_list ::= row_literal row_tail ;

row_tail ::= COMMA row_literal row_tail
           | /* empty */
           ;

row_literal ::= BLOCK_OPEN cell_list BLOCK_CLOSE ;

cell_list ::= num_expr cell_tail ;

cell_tail ::= COMMA num_expr cell_tail
            | /* empty */
            ;

call_expr ::= IDENTIFIER:id
              {:
                  usarFuncion(id, idleft, idright);
              :}
              PIPE_L argument_block_opt PIPE_R
              {:
                  SymbolInfo s = tablaSimbolos.lookupGlobal(id);
                  RESULT = s != null ? s.getType() : DataType.UNKNOWN;
              :}
              ;

argument_block_opt ::= argument_list
                     | /* empty */
                     ;

argument_list ::= expression argument_tail ;

argument_tail ::= COMMA expression argument_tail
                | /* empty */
                ;

read_stmt ::= CIN TILDE read_target ;

read_target ::= IDENTIFIER:id
                {:
                    usarVariable(id, idleft, idright);
                :}
              | array_access
              ;

write_stmt ::= COUT TILDE output_list ;

output_list ::= output_value output_tail ;

output_tail ::= COMMA output_value output_tail
              | /* empty */
              ;

output_value ::= IDENTIFIER:id
                 {:
                     usarVariable(id, idleft, idright);
                 :}
               | array_access
               | numeric_literal
               | MINUS numeric_literal
               | bool_literal
               | CHAR_LITERAL
               | STRING_LITERAL
               ;

if_stmt ::= IF TILDE PIPE_L condition PIPE_R block else_opt ;

else_opt ::= ELSE TILDE block
           | /* empty */
           ;

do_while_stmt ::= DO TILDE block TILDE WHILE TILDE PIPE_L condition PIPE_R BANG ;

switch_stmt ::= SWITCH TILDE PIPE_L expression PIPE_R TILDE BLOCK_OPEN switch_body BLOCK_CLOSE
              | SWITCH TILDE PIPE_L expression PIPE_R TILDE BLOCK_OPEN error BLOCK_CLOSE
              ;

switch_body ::= case_list default_opt ;

case_list ::= case_section case_list
            | /* empty */
            ;

case_section ::= CASE TILDE case_constant TILDE block ;

default_opt ::= DEFAULT TILDE block
              | /* empty */
              ;

case_constant ::= INTEGER_LITERAL
                | FLOAT_LITERAL
                | SCIENTIFIC_LITERAL
                | FRACTION_LITERAL
                | CHAR_LITERAL
                | bool_literal
                ;

return_stmt ::= RETURN TILDE expression ;

break_stmt ::= BREAK ;

expression ::= bool_expr:b  {: RESULT = b; :}
             | num_expr:n   {: RESULT = n; :}
             | string_expr:s {: RESULT = s; :}
             | char_expr:c  {: RESULT = c; :}
             ;

condition ::= bool_expr:b    {: RESULT = b; :}
            | reference_expr:r {: RESULT = r; :}
            ;

reference_expr ::= IDENTIFIER:id
                   {:
                       usarVariable(id, idleft, idright);
                       SymbolInfo s = tablaSimbolos.lookup(id);
                       RESULT = s != null ? s.getType() : DataType.UNKNOWN;
                   :}
                 | call_expr:c
                   {: RESULT = c; :}
                 ;

bool_expr ::= bool_chain:b
              {: RESULT = b; :}
            ;

bool_chain ::= conj_term:c bool_chain_tail:t
               {: RESULT = DataType.BOOL; :}
             ;

bool_chain_tail ::= OR conj_term:c bool_chain_tail:t
                    {: RESULT = DataType.BOOL; :}
                  | /* empty */
                    {: RESULT = null; :}
                  ;

conj_term ::= bool_unit:b conj_term_tail:t
              {: RESULT = DataType.BOOL; :}
            ;

conj_term_tail ::= AND bool_unit:b conj_term_tail:t
                   {: RESULT = DataType.BOOL; :}
                 | /* empty */
                   {: RESULT = null; :}
                 ;

bool_unit ::= NOT bool_unit:b
              {: RESULT = b; :}
            | bool_atom:a
              {: RESULT = a; :}
            ;

bool_atom ::= bool_literal:b
              {: RESULT = b; :}
            | rel_expr:r
              {: RESULT = r; :}
            | PIPE_L bool_expr:e PIPE_R
              {: RESULT = e; :}
            ;

rel_expr ::= EQUAL PIPE_L eq_operand COMMA eq_operand PIPE_R
             {: RESULT = DataType.BOOL; :}
           | N_EQUAL PIPE_L eq_operand COMMA eq_operand PIPE_R
             {: RESULT = DataType.BOOL; :}
           | LESS_T PIPE_L num_expr COMMA num_expr PIPE_R
             {: RESULT = DataType.BOOL; :}
           | LESS_TE PIPE_L num_expr COMMA num_expr PIPE_R
             {: RESULT = DataType.BOOL; :}
           | GREATHER_T PIPE_L num_expr COMMA num_expr PIPE_R
             {: RESULT = DataType.BOOL; :}
           | GREATHER_TE PIPE_L num_expr COMMA num_expr PIPE_R
             {: RESULT = DataType.BOOL; :}
           ;

eq_operand ::= num_expr:n  {: RESULT = n; :}
             | bool_expr:b {: RESULT = b; :}
             ;

bool_literal ::= TRUE  {: RESULT = DataType.BOOL; :}
               | FALSE {: RESULT = DataType.BOOL; :}
               ;

num_expr ::= sum_stage:s
             {: RESULT = s; :}
           ;

sum_stage ::= prod_stage:p sum_tail:t
              {: RESULT = t != null ? t : p; :}
            ;

sum_tail ::= PLUS prod_stage:p sum_tail:t
             {: RESULT = t != null ? t : p; :}
           | MINUS prod_stage:p sum_tail:t
             {: RESULT = t != null ? t : p; :}
           | /* empty */
             {: RESULT = null; :}
           ;

prod_stage ::= power_stage:p prod_tail:t
               {: RESULT = t != null ? t : p; :}
             ;

prod_tail ::= TIMES power_stage:p prod_tail:t
              {: RESULT = t != null ? t : p; :}
            | DIV power_stage:p prod_tail:t
              {: RESULT = t != null ? t : p; :}
            | MOD power_stage:p prod_tail:t
              {: RESULT = t != null ? t : p; :}
            | /* empty */
              {: RESULT = null; :}
            ;

power_stage ::= prefix_stage:p POW power_stage:pw
                {: RESULT = p; :}
              | prefix_stage:p
                {: RESULT = p; :}
              ;

prefix_stage ::= MINUS negative_literal:n
                 {: RESULT = n; :}
               | INC incrementable
                 {: RESULT = DataType.INT; :}
               | DEC incrementable
                 {: RESULT = DataType.INT; :}
               | num_atom:n
                 {: RESULT = n; :}
               ;

num_atom ::= numeric_literal:n
             {: RESULT = n; :}
           | reference_expr:r
             {: RESULT = r; :}
           | array_access:a
             {: RESULT = a; :}
           | PIPE_L num_expr:e PIPE_R
             {: RESULT = e; :}
           ;

incrementable ::= IDENTIFIER ;

negative_literal ::= INTEGER_LITERAL    {: RESULT = DataType.INT; :}
                   | FLOAT_LITERAL      {: RESULT = DataType.FLOAT; :}
                   | SCIENTIFIC_LITERAL {: RESULT = DataType.SCIENTIFIC; :}
                   | FRACTION_LITERAL   {: RESULT = DataType.FRAC; :}
                   ;

numeric_literal ::= INTEGER_LITERAL    {: RESULT = DataType.INT; :}
                  | FLOAT_LITERAL      {: RESULT = DataType.FLOAT; :}
                  | SCIENTIFIC_LITERAL {: RESULT = DataType.SCIENTIFIC; :}
                  | FRACTION_LITERAL   {: RESULT = DataType.FRAC; :}
                  ;

string_expr ::= STRING_LITERAL
                {: RESULT = DataType.STRING; :}
              ;

char_expr ::= CHAR_LITERAL
              {: RESULT = DataType.CHAR; :}
            ;