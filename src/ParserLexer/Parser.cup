package Sintactico;

import java_cup.runtime.Symbol;
import java.util.ArrayList;
import java.util.List;
import java.util.Deque;
import java.util.ArrayDeque;
import Semantico.*;
import Intermedio.*;

parser code {:
    /** Lista de errores sintácticos detectados durante el parsing */
    private final List<String> erroresSintacticos = new ArrayList<>();

    /** Lista de errores semánticos detectados durante el análisis */
    private final List<String> erroresSemanticos = new ArrayList<>();

    /** Mapa que asocia símbolos con su nombre interno usado en el IR */
    private final java.util.Map<String, String> irNames = new java.util.HashMap<>();

    /** Gestor principal de la tabla de símbolos */
    private final SymbolTableManager tablaSimbolos = new SymbolTableManager();

    /** Referencia a la función actualmente en análisis */
    private SymbolInfo currentFunction = null;

    /** Contador para generar nombres de scopes anónimos */
    private int blockCounter = 0;

    /** Contador de profundidad dentro de estructuras de loop */
    private int dentroDeLoop = 0;

    /** Generador de nombres de variables temporales */
    private final IntermediateCode codigoIntermedio = new IntermediateCode();

    /** Generador de etiquetas de bucles y condicionales */
    private final Deque<String> breakLabels = new ArrayDeque<>();

    /** Generador de etiquetas de estructuras de control */
    private final Deque<String[]> ifLabels = new ArrayDeque<>();

    /** Generador de etiquetas de estructuras de repetición */
    private final Deque<String[]> loopLabels = new ArrayDeque<>();

    /** Generador de etiquetas de estructuras de selección */
    private final Deque<SwitchState> switchStack = new ArrayDeque<>();

    private boolean currentFunctionHasReturn = false;

    /** Retorna la lista de errores sintácticos acumulados */
    public List<String> getErroresSintacticos() {
        return erroresSintacticos;
    }

    /** Retorna la lista de errores semánticos acumulados */
    public List<String> getErroresSemanticos() {
        return erroresSemanticos;
    }

    /** Indica si existe algún error sintáctico o semántico */
    public boolean tieneErrores() {
        return !erroresSintacticos.isEmpty() || !erroresSemanticos.isEmpty();
    }

    /** Indica si existen errores semánticos */
    public boolean tieneErroresSemanticos() {
        return !erroresSemanticos.isEmpty();
    }

    /** Retorna la tabla de símbolos construida durante el análisis */
    public SymbolTableManager getTablaSimbolos() {
        return tablaSimbolos;
    }

    /** Obtiene el nombre de la función actual o un valor por defecto */
    private String nombreFuncionActual() {
    return currentFunction != null ? currentFunction.getLexeme() : "<desconocida>";
    }

    /** Obtiene la línea de declaración de la función actual */
    private int lineaFuncionActual() {
        return currentFunction != null ? currentFunction.getLine() : -1;
    }

    /**
    * Convierte el código numérico de un token a su nombre legible.
    *
    * @param tok Token del cual se quiere obtener el nombre.
    * @return Nombre del token, o "EOF" si el token es null.
    */
    private String nombreToken(Symbol tok) {
        if (tok == null) return "EOF";
        try {
            return sym.terminalNames[tok.sym];
        } catch (Exception e) {
            return "SYM(" + tok.sym + ")";
        }
    }
    
    /**
    * Retorna el lexema de un token. Si el token no tiene valor semántico,
    * retorna su nombre como fallback.
    *
    * @param tok Token del cual se quiere obtener el lexema.
    * @return Lexema del token, o su nombre si no tiene valor.
    */
    private String lexemaToken(Symbol tok) {
        if (tok == null) return "<EOF>";
        return tok.value != null ? tok.value.toString() : nombreToken(tok);
    }

    /**
    * Registra un error semántico en la lista de errores.
    *
    * @param mensaje Descripción del error semántico encontrado.
    */
    private void errorSemantico(String mensaje) {
        erroresSemanticos.add(mensaje);
    }

    /**
    * Registra una función o procedimiento en la tabla de símbolos global
    * y abre un nuevo scope con su nombre.
    * Si la función ya fue declarada, reporta un error semántico.
    *
    * @param name       Nombre de la función o procedimiento.
    * @param returnType Tipo de retorno de la función.
    * @param line       Línea de declaración en el archivo fuente.
    * @param col        Columna de declaración en el archivo fuente.
    * @param isMain     true si es el procedimiento principal __main__.
    */
    private void declararFuncion(String name, DataType returnType, int line, int col, boolean isMain) {
        SymbolInfo info = new SymbolInfo(
                name,
                isMain ? SymbolKind.MAIN : SymbolKind.FUNCTION,
                isMain ? DataType.EMPTY : returnType,
                line,
                col,
                "global",
                0
        );

        boolean inserted = tablaSimbolos.insertIntoGlobal(info);
        if (!inserted) {
            errorSemantico(
                "Error semántico: redeclaración de función/procedimiento '" + name +
                "' en línea " + line + ", columna " + col
            );
            currentFunction = tablaSimbolos.lookupGlobal(name);
        } else {
            currentFunction = info;
        }

        tablaSimbolos.enterScope(name);
        codigoIntermedio.add("FUNC_BEGIN", name, (isMain ? "EMPTY" : returnType.toString()), "-");
    }

    /**
    * Cierra el scope de la función actual y limpia la referencia a la función activa.
    */
    private void cerrarFuncion() {
        if (currentFunction != null) {
            if (currentFunction.getType() != DataType.EMPTY && !currentFunctionHasReturn) {
                errorSemantico(
                    "Error semántico: función '" + currentFunction.getLexeme() +
                    "' debe retornar un valor de tipo " + currentFunction.getType() +
                    " pero no tiene 'return' en línea " + currentFunction.getLine()
                );
            }
            codigoIntermedio.add("FUNC_END", currentFunction.getLexeme(), "-", "-");
        }
        currentFunction = null;
        currentFunctionHasReturn = false;
        tablaSimbolos.exitScope();
    }

    /**
    * Registra los parámetros de una función en el scope actual y los agrega
    * a la firma de la función activa.
    * Reporta error semántico si algún parámetro está redeclarado.
    *
    * @param params Lista de ParameterInfo con los parámetros a registrar.
    */
    private void registrarParametros(ArrayList params) {
        if (params == null) return;

        for (Object obj : params) {
            ParameterInfo p = (ParameterInfo) obj;

            SymbolInfo s = new SymbolInfo(
                    p.getName(),
                    SymbolKind.PARAMETER,
                    p.getType(),
                    p.getLine(),
                    p.getColumn(),
                    tablaSimbolos.currentScope().getName(),
                    tablaSimbolos.currentScope().getLevel()
            );
            s.setInitialized(true);

            boolean inserted = tablaSimbolos.insert(s);
            if (!inserted) {
                registrarIrName(s);
                errorSemantico(
                    "Error semántico: parámetro redeclarado '" + p.getName() +
                    "' en línea " + p.getLine() + ", columna " + p.getColumn()
                );
            }

            if (currentFunction != null) {
                currentFunction.addParameter(p.getName(), p.getType());
            }
            codigoIntermedio.add("PARAM_DEF", getIrName(s), p.getType().toString(), "-");
        }
    }

    /**
    * Registra un identificador (variable o arreglo) en el scope actual.
    * Reporta error semántico si el identificador ya fue declarado en el mismo scope.
    *
    * @param name Nombre del identificador.
    * @param type Tipo de dato del identificador.
    * @param tail Información del sufijo de la declaración (escalar o arreglo, inicializado o no).
    * @param line Línea de declaración en el archivo fuente.
    * @param col  Columna de declaración en el archivo fuente.
    */
    private void declararIdentificador(String name, DataType type, DeclTailInfo tail, int line, int col) {
        // verificar si existe en el scope padre (parámetros de la función)
        ScopeTable parent = tablaSimbolos.currentScope().getParent();
        if (parent != null && parent.containsLocal(name)) {
            errorSemantico(
                "Error semántico: identificador '" + name +
                "' ya fue declarado como parámetro en línea " + line + ", columna " + col
            );
            return;
        }
        SymbolKind kind = tail.isArray() ? SymbolKind.ARRAY : SymbolKind.VARIABLE;

        SymbolInfo info = new SymbolInfo(
                name,
                kind,
                type,
                line,
                col,
                tablaSimbolos.currentScope().getName(),
                tablaSimbolos.currentScope().getLevel()
        );

        info.setInitialized(tail.isInitialized());

        if (tail.isArray()) {
            info.setDimensions(tail.getDim1(), tail.getDim2());
        }

        boolean inserted = tablaSimbolos.insert(info);
        if (!inserted) {
            errorSemantico(
                "Error semántico: identificador redeclarado '" + name +
                "' en línea " + line + ", columna " + col +
                " dentro del scope '" + tablaSimbolos.currentScope().getName() + "'"
            );
        }

        if (inserted) {
            registrarIrName(info);
            String irName = getIrName(info);

            if (tail.isArray()) {
                codigoIntermedio.add("ARRAY_DEF", irName, type.toString(), tail.getDim1() + "," + tail.getDim2());

                if (tail.getMatrixInit() != null) {
                    ArrayList filas = tail.getMatrixInit();
                    for (int i = 0; i < filas.size(); i++) {
                        ArrayList celdas = (ArrayList) filas.get(i);
                        for (int j = 0; j < celdas.size(); j++) {
                            ExprAttr cell = (ExprAttr) celdas.get(j);
                            codigoIntermedio.add("ARRAY_STORE", cell.place, "-", irName + "[" + i + "," + j + "]");
                        }
                    }
                }
            } else {
                codigoIntermedio.add("LOCAL_DEF", irName, type.toString(), "-");

                if (tail.getExprPlace() != null) {
                    codigoIntermedio.add("ASSIGN", tail.getExprPlace(), "-", irName);
                }
            }
        }
    }

    /**
    * Verifica que un identificador usado en el código haya sido declarado previamente
    * y que sea una variable o parámetro (no función ni arreglo sin índices).
    * Marca el símbolo como usado si la verificación es exitosa.
    *
    * @param name Nombre del identificador referenciado.
    * @param line Línea de uso en el archivo fuente.
    * @param col  Columna de uso en el archivo fuente.
    */
    private void usarVariable(String name, int line, int col) {
        SymbolInfo s = tablaSimbolos.lookup(name);

        if (s == null) {
            errorSemantico(
                "Error semántico: identificador no declarado '" + name +
                "' en línea " + line + ", columna " + col
            );
            return;
        }

        if (s.getKind() == SymbolKind.FUNCTION || s.getKind() == SymbolKind.MAIN) {
            errorSemantico(
                "Error semántico: '" + name +
                "' es una función/procedimiento y no una variable en línea " + line + ", columna " + col
            );
            return;
        }

        if (s.getKind() == SymbolKind.ARRAY) {
            errorSemantico(
                "Error semántico: el arreglo '" + name +
                "' requiere índices en línea " + line + ", columna " + col
            );
            return;
        }

        s.setUsed(true);
    }

    /**
    * Verifica que un arreglo usado en el código haya sido declarado previamente
    * y que efectivamente sea de tipo ARRAY.
    * Marca el símbolo como usado si la verificación es exitosa.
    *
    * @param name Nombre del arreglo referenciado.
    * @param line Línea de uso en el archivo fuente.
    * @param col  Columna de uso en el archivo fuente.
    */
    private void usarArreglo(String name, int line, int col) {
        SymbolInfo s = tablaSimbolos.lookup(name);

        if (s == null) {
            errorSemantico(
                "Error semántico: arreglo no declarado '" + name +
                "' en línea " + line + ", columna " + col
            );
            return;
        }

        if (s.getKind() != SymbolKind.ARRAY) {
            errorSemantico(
                "Error semántico: '" + name +
                "' no es un arreglo en línea " + line + ", columna " + col
            );
            return;
        }

        s.setUsed(true);
    }

    /**
    * Verifica que una función o procedimiento llamado en el código haya sido
    * declarado previamente en el scope global.
    * Marca el símbolo como usado si la verificación es exitosa.
    *
    * @param name Nombre de la función referenciada.
    * @param line Línea de uso en el archivo fuente.
    * @param col  Columna de uso en el archivo fuente.
    */
    private void usarFuncion(String name, int line, int col) {
        SymbolInfo s = tablaSimbolos.lookupGlobal(name);

        if (s == null) {
            errorSemantico(
                "Error semántico: función/procedimiento no declarado '" + name +
                "' en línea " + line + ", columna " + col
            );
            return;
        }

        if (s.getKind() != SymbolKind.FUNCTION && s.getKind() != SymbolKind.MAIN) {
            errorSemantico(
                "Error semántico: '" + name +
                "' no es una función/procedimiento en línea " + line + ", columna " + col
            );
            return;
        }

        s.setUsed(true);
    }

    /**
    * Abre un nuevo scope anónimo para un bloque de código sin nombre de función.
    * El nombre del scope se genera automáticamente como "block_N".
    */
    private void entrarBloqueAnonimo() {
        blockCounter++;
        tablaSimbolos.enterScope("block_" + blockCounter);
    }

    /**
    * Cierra el scope actualmente activo retirándolo de la pila.
    */
    private void salirScope() {
        tablaSimbolos.exitScope();
    }

    /**
    * Maneja los errores sintácticos detectados por CUP durante el parsing.
    * Registra el error con línea, columna y token encontrado, y continúa el análisis.
    *
    * @param cur_token Token donde se detectó el error sintáctico.
    */
    @Override
    public void syntax_error(Symbol cur_token) {
        String mensaje =
                "Error sintáctico en línea " + (cur_token != null ? cur_token.left : -1) +
                ", columna " + (cur_token != null ? cur_token.right : -1) +
                ". Token encontrado: " + nombreToken(cur_token) +
                " (" + lexemaToken(cur_token) + ")";
        erroresSintacticos.add(mensaje);
    }

    /**
    * Maneja los errores sintácticos de los que CUP no pudo recuperarse.
    * Registra el error y detiene el parsing con done_parsing().
    *
    * @param cur_token Token donde falló la recuperación.
    * @throws Exception Si no fue posible continuar el análisis.
    */
    @Override
    public void unrecovered_syntax_error(Symbol cur_token) throws Exception {
        String mensaje =
                "Recuperación fallida en línea " + (cur_token != null ? cur_token.left : -1) +
                ", columna " + (cur_token != null ? cur_token.right : -1) +
                ". No fue posible continuar desde: " + nombreToken(cur_token) +
                " (" + lexemaToken(cur_token) + ")";
        erroresSintacticos.add(mensaje);
        done_parsing();
    }

    /**
    * Reporta un error de recuperación a nivel de frase.
    * Se usa cuando el parser detecta un error específico y predecible,
    * como la falta del terminador '!' al final de una sentencia.
    *
    * @param mensaje Descripción del error detectado.
    * @param linea   Línea exacta donde ocurrió el error.
    */
    private void reportarErrorFrase(String mensaje, int linea) {
        String msg = "Error de frase en línea " + linea + ": " + mensaje;
        erroresSintacticos.add(msg);
        System.out.println(msg);
    }

    /**
    * Verifica si dos tipos de datos son compatibles en el contexto de una operación.
    * Se consideran compatibles:
    * - INT y SCIENTIFIC
    * - INT y FRAC
    * - FLOAT y INT
    *
    * @param destino Tipo de dato destino de la operación
    * @param origen  Tipo de dato origen de la operación
    * @return true si son compatibles, false en caso contrario
    */
    private boolean tiposCompatibles(DataType destino, DataType origen) {
        return destino == origen;
    }

    /**
    * Indica si un tipo de dato es numérico.
    *
    * @param t Tipo de dato a verificar
    * @return true si es numérico, false en caso contrario
    */
    private boolean esNumerico(DataType t) {
        return t == DataType.INT ||
            t == DataType.FLOAT ||
            t == DataType.SCIENTIFIC ||
            t == DataType.FRAC;
    }

    /** Retorna el código intermedio construido durante el análisis */
    public IntermediateCode getCodigoIntermedio() {
        return codigoIntermedio;
    }

    /** Clase auxiliar para almacenar información de una expresión */
    public static class ExprAttr {
        public final DataType type;
        public final String place;

        public ExprAttr(DataType type, String place) {
            this.type = type;
            this.place = place;
        }
    }

    /** Clase auxiliar para almacenar información de un identificador */
    public static class LValueAttr {
        public final String sourceName;   
        public final String irName;      
        public final DataType type;
        public final boolean isArray;
        public final String row;
        public final String col;

        /** Construye un nuevo atributo de un identificador */
        public LValueAttr(String sourceName, String irName, DataType type) {
            this(sourceName, irName, type, false, null, null);
        }

        /** Construye un nuevo atributo de un identificador */
        public LValueAttr(String sourceName, String irName, DataType type, boolean isArray, String row, String col) {
            this.sourceName = sourceName;
            this.irName = irName;
            this.type = type;
            this.isArray = isArray;
            this.row = row;
            this.col = col;
        }

        /** Devuelve el nombre de la variable o el nombre del arreglo */
        public String render() {
            if (!isArray) return irName;
            return irName + "[" + row + "," + col + "]";
        }
    }

    /** Clase auxiliar para almacenar información de una instrucción de secuencia */
    private static class Step {
        public final String op;
        public final ExprAttr expr;

        /** Construye una nueva instrucción de secuencia */
        public Step(String op, ExprAttr expr) {
            this.op = op;
            this.expr = expr;
        }
    }

    /** Clase auxiliar para almacenar información de un bloque de estructura de selección */
    private static class SwitchState {
        public final ExprAttr control;
        public final String endLabel;
        public final String matchedName;
        public String nextCaseLabel;

        public SwitchState(ExprAttr control, String endLabel, String matchedName) {
            this.control = control;
            this.endLabel = endLabel;
            this.matchedName = matchedName;
            this.nextCaseLabel = null;
        }
    }

    /** Emite una instrucción de operación binaria */
    private ExprAttr emitBinary(String op, ExprAttr a, ExprAttr b) {
        DataType resultType;

        if (op.equals("AND") || op.equals("OR") ||
            op.equals("EQ") || op.equals("NE") ||
            op.equals("LT") || op.equals("LE") ||
            op.equals("GT") || op.equals("GE")) {
            resultType = DataType.BOOL;
        } else {
            resultType = promoverNumerico(a.type, b.type);
        }

        String t = codigoIntermedio.newTemp();
        codigoIntermedio.add(op, a.place, b.place, t);
        return new ExprAttr(resultType, t);
    }

    /** Emite una instrucción de operación unaria */
    private ExprAttr emitUnary(String op, ExprAttr a) {
        String t = codigoIntermedio.newTemp();
        codigoIntermedio.add(op, a.place, "-", t);

        if (op.equals("NOT")) {
            return new ExprAttr(DataType.BOOL, t);
        }
        return new ExprAttr(a.type, t);
    }

    /** Aplica una secuencia de instrucciones de operación binaria */
    private ExprAttr fold(ExprAttr base, ArrayList steps) {
        ExprAttr result = base;
        for (Object obj : steps) {
            Step s = (Step) obj;
            result = emitBinary(s.op, result, s.expr);
        }
        return result;
    }

    /** Crea una nueva fila de una matriz */
    private ArrayList nuevaFila() {
        return new ArrayList();
    }

    /** Crea una nueva matriz */
    private ArrayList nuevaMatriz() {
        return new ArrayList();
    }

    /** Promueve los tipos numéricos de dos operandos */
    private DataType promoverNumerico(DataType a, DataType b) {
        if (a == null || b == null) return DataType.UNKNOWN;
        if (a == DataType.UNKNOWN || b == DataType.UNKNOWN) return DataType.UNKNOWN;

        if (a == DataType.FLOAT || b == DataType.FLOAT) return DataType.FLOAT;
        if (a == DataType.SCIENTIFIC || b == DataType.SCIENTIFIC) return DataType.FLOAT;
        if (a == DataType.FRAC || b == DataType.FRAC) return DataType.FLOAT;

        return DataType.INT;
    }

    /** Marca un identificador como inicializado */
    private void marcarInicializado(String name, int line, int col) {
        SymbolInfo s = tablaSimbolos.lookup(name);

        if (s == null) {
            errorSemantico(
                "Error semántico: identificador no declarado '" + name +
                "' en línea " + line + ", columna " + col
            );
            return;
        }

        s.setInitialized(true);
    }

    /** Devuelve una clave única para un símbolo */
    private String symbolKey(SymbolInfo s) {
        if (s == null) return null;
        return s.getScopeName() + "::" + s.getLexeme() + "@" + s.getLine() + ":" + s.getColumn();
    }

    /** Elimina caracteres no válidos de un nombre de scope */
    private String sanitizeScopeName(String name) {
        if (name == null) return "scope";
        return name.replaceAll("[^a-zA-Z0-9_]", "_");
    }

    /** Genera un nombre único para un símbolo en el IR */
    private String buildIrName(SymbolInfo s) {
        if (s == null) return null;

        if (s.getKind() == SymbolKind.FUNCTION || s.getKind() == SymbolKind.MAIN) {
            return s.getLexeme();
        }

        if (s.getScopeLevel() <= 1) {
            return s.getLexeme();
        }

        return s.getLexeme() + "_" + sanitizeScopeName(s.getScopeName());
    }

    /** Registra un nombre único para un símbolo en el IR */
    private void registrarIrName(SymbolInfo s) {
        if (s == null) return;
        irNames.put(symbolKey(s), buildIrName(s));
    }

    /** Obtiene el nombre único de un símbolo en el IR */
    private String getIrName(SymbolInfo s) {
        if (s == null) return null;
        return irNames.getOrDefault(symbolKey(s), s.getLexeme());
    }

    private boolean sonMismoGrupo(DataType a, DataType b) {
        if (a == b) return true;
        if (esNumerico(a) && esNumerico(b)) return true;
        if (a == DataType.BOOL && b == DataType.BOOL) return true;
        if (a == DataType.CHAR && b == DataType.CHAR) return true;
        if (a == DataType.STRING && b == DataType.STRING) return true;
        return false;
    }
    private void verificarMatriz(String nombre, DataType tipoArreglo, ArrayList matriz, 
                                int dimFilas, int dimCols, int line) {
        // verificar número de filas
        if (matriz.size() != dimFilas) {
            errorSemantico(
                "Error semántico: arreglo '" + nombre + "' declarado con " + dimFilas +
                " filas pero se inicializó con " + matriz.size() +
                " en línea " + line
            );
        }

            // verificar cada fila
            for (int i = 0; i < matriz.size(); i++) {
                ArrayList fila = (ArrayList) matriz.get(i);

                // verificar número de columnas
                if (fila.size() != dimCols) {
                    errorSemantico(
                        "Error semántico: fila " + i + " del arreglo '" + nombre + "' declarada con " +
                        dimCols + " columnas pero se inicializó con " + fila.size() +
                        " en línea " + line
                    );
                }

                // verificar tipo de cada celda
                for (int j = 0; j < fila.size(); j++) {
                    ExprAttr celda = (ExprAttr) fila.get(j);
                    if (celda.type != null && celda.type != DataType.UNKNOWN &&
                        !tiposCompatibles(tipoArreglo, celda.type)) {
                        errorSemantico(
                            "Error semántico: celda [" + i + "," + j + "] del arreglo '" + nombre +
                            "' es de tipo " + celda.type + " pero se esperaba " + tipoArreglo +
                            " en línea " + line
                        );
                    }
                }
            }
    }
    

:};

terminal INT_T, FLOAT_T, BOOL_T, CHAR_T, STRING_T, SCIENTIFIC_T, FRAC_T, EMPTY_T;
terminal IF, ELSE, DO, WHILE, SWITCH, CASE, DEFAULT, RETURN, BREAK, CIN, COUT;
terminal TRUE, FALSE, MAIN;
terminal EQUAL, N_EQUAL, LESS_T, LESS_TE, GREATHER_T, GREATHER_TE;
terminal TILDE, ASSIGN, PIPE_L, PIPE_R, BLOCK_OPEN, BLOCK_CLOSE, INDEX_OPEN, INDEX_CLOSE, BANG, COMMA;
terminal PLUS, MINUS, TIMES, DIV, MOD, POW, INC, DEC, AND, OR, NOT;
terminal String IDENTIFIER, INTEGER_LITERAL, FLOAT_LITERAL, SCIENTIFIC_LITERAL, FRACTION_LITERAL, CHAR_LITERAL, STRING_LITERAL;

non terminal program;
non terminal function_prefix, function_suffix, function_decl, main_procedure;
non terminal function_decl_rest, main_rest;

non terminal java.util.ArrayList parameter_block_opt, parameter_list, parameter_tail;

non terminal block, block_items, block_item;
non terminal statement;

non terminal declaration_stmt, typed_decl;
non terminal assign_stmt;

non terminal LValueAttr lvalue;

non terminal LValueAttr array_access;

non terminal java.util.ArrayList matrix_literal, row_list, row_tail, row_literal, cell_list, cell_tail;
non terminal java.util.ArrayList argument_block_opt, argument_list, argument_tail;

non terminal ExprAttr call_expr;

non terminal read_stmt;
non terminal LValueAttr read_target;
non terminal write_stmt, output_list, output_tail;
non terminal ExprAttr output_value;
non terminal if_stmt, else_opt, do_while_stmt, switch_stmt, switch_body, case_list, case_section, default_opt;
non terminal switch_stmt_body;
non terminal ExprAttr case_constant;
non terminal return_stmt, break_stmt;

non terminal ExprAttr expression, condition;
non terminal ExprAttr reference_expr;

non terminal ExprAttr bool_expr, bool_chain, conj_term, bool_unit, bool_atom, rel_expr, eq_operand, bool_literal;
non terminal java.util.ArrayList bool_chain_tail, conj_term_tail;
non terminal ExprAttr num_expr, sum_stage, prod_stage, power_stage, prefix_stage, num_atom, incrementable, negative_literal, numeric_literal;
non terminal java.util.ArrayList sum_tail, prod_tail;
non terminal ExprAttr string_expr, char_expr;

non terminal DataType return_type, data_type, non_array_type;
non terminal ParameterInfo parameter;
non terminal DeclTailInfo int_decl_tail, float_decl_tail, other_decl_tail;
non terminal java.util.ArrayList array_init_opt;
non terminal block_body;
non terminal block_enter;
non terminal loop_enter, loop_exit;

start with program;

program ::= function_prefix main_procedure function_suffix ;

function_prefix ::= function_decl function_prefix
                  | /* empty */
                  ;

function_suffix ::= function_decl function_suffix
                  | /* empty */
                  ;

function_decl ::= return_type:rt TILDE IDENTIFIER:id
                  {:
                      declararFuncion(id, rt, idleft, idright, false);
                  :}
                  function_decl_rest
                  {:
                      cerrarFuncion();
                  :}
                  ;

function_decl_rest ::= PIPE_L parameter_block_opt:params PIPE_R
                       {:
                           registrarParametros(params);
                       :}
                       block
                     | error PIPE_R block
                       {:
                           reportarErrorFrase(
                               "Encabezado inválido de la función '" + nombreFuncionActual() +
                               "'. Se continuó desde el bloque de la función.",
                               lineaFuncionActual()
                           );
                       :}
                     ;

main_procedure ::= EMPTY_T TILDE MAIN:m
                   {:
                       declararFuncion("__main__", DataType.EMPTY, mleft, mright, true);
                   :}
                   main_rest
                   {:
                       cerrarFuncion();
                   :}
                   ;

main_rest ::= PIPE_L PIPE_R block
            | error PIPE_R block
              {:
                  reportarErrorFrase(
                      "Encabezado inválido de __main__. Se continuó desde el bloque principal.",
                      lineaFuncionActual()
                  );
              :}
            ;

return_type ::= INT_T    {: RESULT = DataType.INT; :}
              | FLOAT_T  {: RESULT = DataType.FLOAT; :}
              | CHAR_T   {: RESULT = DataType.CHAR; :}
              | BOOL_T   {: RESULT = DataType.BOOL; :}
              ;

data_type ::= INT_T         {: RESULT = DataType.INT; :}
            | FLOAT_T       {: RESULT = DataType.FLOAT; :}
            | BOOL_T        {: RESULT = DataType.BOOL; :}
            | CHAR_T        {: RESULT = DataType.CHAR; :}
            | STRING_T      {: RESULT = DataType.STRING; :}
            | SCIENTIFIC_T  {: RESULT = DataType.SCIENTIFIC; :}
            | FRAC_T        {: RESULT = DataType.FRAC; :}
            ;

parameter_block_opt ::= parameter_list:p
                        {: RESULT = p; :}
                      | /* empty */
                        {: RESULT = new java.util.ArrayList(); :}
                      ;

parameter_list ::= parameter:p parameter_tail:t
                   {:
                       t.add(0, p);
                       RESULT = t;
                   :}
                 ;

parameter_tail ::= COMMA parameter:p parameter_tail:t
                   {:
                       t.add(0, p);
                       RESULT = t;
                   :}
                 | /* empty */
                   {: RESULT = new java.util.ArrayList(); :}
                 ;

parameter ::= data_type:t TILDE IDENTIFIER:id
              {: RESULT = new ParameterInfo(id, t, idleft, idright); :}
              ;

block ::= BLOCK_OPEN block_enter block_body BLOCK_CLOSE
          {: salirScope(); :}
        ;

block_enter ::= 
          {: entrarBloqueAnonimo(); :}
        ;

block_body ::= block_items
             | error
             ;

block_items ::= block_item block_items
              | /* empty */
              ;

block_item ::= statement ;

statement ::= declaration_stmt BANG
            | assign_stmt BANG
            | num_expr BANG
            | bool_expr BANG
            | string_expr BANG
            | char_expr BANG
            | if_stmt
            | do_while_stmt
            | switch_stmt
            | read_stmt BANG
            | write_stmt BANG
            | return_stmt BANG
            | break_stmt BANG
            | block
            | error BANG
            ;

declaration_stmt ::= typed_decl ;

typed_decl ::= INT_T TILDE IDENTIFIER:id int_decl_tail:t
               {:
                   declararIdentificador(id, DataType.INT, t, idleft, idright);
                   if (t.getExprType() != null && !tiposCompatibles(DataType.INT, t.getExprType())) {
                       errorSemantico(
                           "Error semántico: tipos incompatibles en declaración de '" + id +
                           "', se esperaba INT pero se encontró " + t.getExprType() +
                           " en línea " + idleft
                       );
                   }
                   if (t.isArray() && t.getMatrixInit() != null) {
                       verificarMatriz(id, DataType.INT, t.getMatrixInit(),
                                      t.getDim1(), t.getDim2(), idleft);
                   }
               :}
             | FLOAT_T TILDE IDENTIFIER:id float_decl_tail:t
               {:
                   declararIdentificador(id, DataType.FLOAT, t, idleft, idright);
                   if (t.getExprType() != null && !tiposCompatibles(DataType.FLOAT, t.getExprType())) {
                       errorSemantico(
                           "Error semántico: tipos incompatibles en declaración de '" + id +
                           "', se esperaba FLOAT pero se encontró " + t.getExprType() +
                           " en línea " + idleft
                       );
                   }
                   if (t.isArray() && t.getMatrixInit() != null) {
                       verificarMatriz(id, DataType.FLOAT, t.getMatrixInit(),
                                      t.getDim1(), t.getDim2(), idleft);
                   }
               :}
             | non_array_type:tp TILDE IDENTIFIER:id other_decl_tail:t
               {:
                   declararIdentificador(id, tp, t, idleft, idright);
                   if (t.getExprType() != null && !tiposCompatibles(tp, t.getExprType())) {
                       errorSemantico(
                           "Error semántico: tipos incompatibles en declaración de '" + id +
                           "', se esperaba " + tp + " pero se encontró " + t.getExprType() +
                           " en línea " + idleft
                       );
                   }
               :}
             ;

non_array_type ::= BOOL_T        {: RESULT = DataType.BOOL; :}
                 | CHAR_T        {: RESULT = DataType.CHAR; :}
                 | STRING_T      {: RESULT = DataType.STRING; :}
                 | SCIENTIFIC_T  {: RESULT = DataType.SCIENTIFIC; :}
                 | FRAC_T        {: RESULT = DataType.FRAC; :}
                 ;

other_decl_tail ::= ASSIGN expression:e
                    {: RESULT = DeclTailInfo.scalar(true, e.type, e.place); :}
                  | /* empty */
                    {: RESULT = DeclTailInfo.scalar(false, null, null); :}
                  ;

int_decl_tail ::= ASSIGN expression:e
                  {: RESULT = DeclTailInfo.scalar(true, e.type, e.place); :}
                | INDEX_OPEN INTEGER_LITERAL:d1 COMMA INTEGER_LITERAL:d2 INDEX_CLOSE array_init_opt:init
                  {: RESULT = DeclTailInfo.array(Integer.parseInt(d1), Integer.parseInt(d2), init != null, init); :}
                | /* empty */
                  {: RESULT = DeclTailInfo.scalar(false, null, null); :}
                ;

float_decl_tail ::= ASSIGN expression:e
                    {: RESULT = DeclTailInfo.scalar(true, e.type, e.place); :}
                  | INDEX_OPEN INTEGER_LITERAL:d1 COMMA INTEGER_LITERAL:d2 INDEX_CLOSE array_init_opt:init
                    {: RESULT = DeclTailInfo.array(Integer.parseInt(d1), Integer.parseInt(d2), init != null, init); :}
                  | /* empty */
                    {: RESULT = DeclTailInfo.scalar(false, null, null); :}
                  ;

array_init_opt ::= ASSIGN matrix_literal:m
                   {: RESULT = m; :}
                 | /* empty */
                   {: RESULT = null; :}
                 ;

assign_stmt ::= lvalue:lv ASSIGN expression:e
                {:
                    if (lv != null && e != null && lv.type != DataType.UNKNOWN && e.type != DataType.UNKNOWN) {
                        if (!tiposCompatibles(lv.type, e.type)) {
                            errorSemantico(
                                "Error semántico: tipos incompatibles en asignación, " +
                                "se esperaba " + lv.type + " pero se encontró " + e.type +
                                " en línea " + lvleft
                            );
                        }
                    }

                    marcarInicializado(lv.sourceName, lvleft, lvright);

                    if (!lv.isArray) {
                        codigoIntermedio.add("ASSIGN", e.place, "-", lv.irName);
                    } else {
                        codigoIntermedio.add("ARRAY_STORE", e.place, "-", lv.render());
                    }
                :}
              ;

lvalue ::= IDENTIFIER:id
           {:
               usarVariable(id, idleft, idright);
               SymbolInfo s = tablaSimbolos.lookup(id);

               String ir = (s != null) ? getIrName(s) : id;
               DataType t = (s != null) ? s.getType() : DataType.UNKNOWN;

               RESULT = new LValueAttr(id, ir, t);
           :}
         | array_access:a
           {: RESULT = a; :}
         ;
         
array_access ::= IDENTIFIER:id
                 {:
                     usarArreglo(id, idleft, idright);
                 :}
                 INDEX_OPEN num_expr:i1 COMMA num_expr:i2 INDEX_CLOSE
                 {:
                     if (i1.type != DataType.INT && i1.type != DataType.UNKNOWN) {
                         errorSemantico(
                             "Error semántico: índice de fila debe ser entero, se encontró " + i1.type +
                             " en línea " + idleft
                         );
                     }
                     if (i2.type != DataType.INT && i2.type != DataType.UNKNOWN) {
                         errorSemantico(
                             "Error semántico: índice de columna debe ser entero, se encontró " + i2.type +
                             " en línea " + idleft
                         );
                     }

                     SymbolInfo s = tablaSimbolos.lookup(id);
                     DataType t = s != null ? s.getType() : DataType.UNKNOWN;
                     String ir = s != null ? getIrName(s) : id;

                     RESULT = new LValueAttr(id, ir, t, true, i1.place, i2.place);
                 :}
               ;

matrix_literal ::= BLOCK_OPEN row_list:r BLOCK_CLOSE
                   {: RESULT = r; :}
                   ;

row_list ::= row_literal:r row_tail:t
             {:
                 ArrayList matriz = nuevaMatriz();
                 matriz.add(r);
                 for (Object obj : t) matriz.add(obj);
                 RESULT = matriz;
             :}
           ;

row_tail ::= COMMA row_literal:r row_tail:t
             {:
                 ArrayList tail = t;
                 tail.add(0, r);
                 RESULT = tail;
             :}
           | /* empty */
             {: RESULT = nuevaMatriz(); :}
           ;

row_literal ::= BLOCK_OPEN cell_list:c BLOCK_CLOSE
                {: RESULT = c; :}
                ;

cell_list ::= num_expr:e cell_tail:t
              {:
                  ArrayList fila = nuevaFila();
                  fila.add(e);
                  for (Object obj : t) fila.add(obj);
                  RESULT = fila;
              :}
            ;

cell_tail ::= COMMA num_expr:e cell_tail:t
              {:
                  ArrayList tail = t;
                  tail.add(0, e);
                  RESULT = tail;
              :}
            | /* empty */
              {: RESULT = nuevaFila(); :}
            ;

call_expr ::= IDENTIFIER:id
              {:
                  usarFuncion(id, idleft, idright);
              :}
              PIPE_L argument_block_opt:args PIPE_R
              {:
                  SymbolInfo s = tablaSimbolos.lookupGlobal(id);
                  if (s != null) {
                      List<DataType> params = s.getParameterTypes();

                      if (params.size() != args.size()) {
                          errorSemantico(
                              "Error semántico: función '" + id + "' espera " +
                              params.size() + " argumentos pero se encontraron " +
                              args.size() + " en línea " + idleft
                          );
                      } else {
                          for (int i = 0; i < params.size(); i++) {
                              DataType esperado = params.get(i);
                              ExprAttr encontrado = (ExprAttr) args.get(i);
                              if (encontrado.type != null && encontrado.type != DataType.UNKNOWN &&
                                  !tiposCompatibles(esperado, encontrado.type)) {
                                  errorSemantico(
                                      "Error semántico: argumento " + (i + 1) +
                                      " de función '" + id + "' incompatible, se esperaba " +
                                      esperado + " pero se encontró " + encontrado.type +
                                      " en línea " + idleft
                                  );
                              }
                          }
                      }
                  }

                  for (Object obj : args) {
                      ExprAttr arg = (ExprAttr) obj;
                      codigoIntermedio.add("PARAM", arg.place, "-", "-");
                  }

                  if (s != null && s.getType() != DataType.EMPTY) {
                      String t = codigoIntermedio.newTemp();
                      codigoIntermedio.add("CALL", id, String.valueOf(args.size()), t);
                      RESULT = new ExprAttr(s.getType(), t);
                  } else {
                      codigoIntermedio.add("CALL", id, String.valueOf(args.size()), "-");
                      RESULT = new ExprAttr(s != null ? s.getType() : DataType.UNKNOWN, "-");
                  }
              :}
            ;

argument_block_opt ::= argument_list:l
                       {: RESULT = l; :}
                     | /* empty */
                       {: RESULT = new java.util.ArrayList(); :}
                     ;

argument_list ::= expression:e argument_tail:t
                  {:
                      t.add(0, e);
                      RESULT = t;
                  :}
                ;

argument_tail ::= COMMA expression:e argument_tail:t
                  {:
                      t.add(0, e);
                      RESULT = t;
                  :}
                | /* empty */
                  {: RESULT = new java.util.ArrayList(); :}
                ;

read_stmt ::= CIN TILDE read_target:rt
              {:
                  codigoIntermedio.add("READ", "-", "-", rt.render());
              :}
            ;

read_target ::= IDENTIFIER:id
                {:
                    usarVariable(id, idleft, idright);
                    SymbolInfo s = tablaSimbolos.lookup(id);
                    if (s != null && s.getType() != DataType.INT && 
                        s.getType() != DataType.FLOAT &&
                        s.getType() != DataType.UNKNOWN) {
                        errorSemantico(
                            "Error semántico: 'cin' solo puede leer variables de tipo INT o FLOAT, " +
                            "se encontró " + s.getType() + " para '" + id + "' en línea " + idleft
                        );
                    }
                    String ir = (s != null) ? getIrName(s) : id;
                    DataType t = (s != null) ? s.getType() : DataType.UNKNOWN;

                    RESULT = new LValueAttr(id, ir, t);
                :}
              | array_access:a
                {: RESULT = a; :}
              ;
              
write_stmt ::= COUT TILDE output_list
               {:
                   codigoIntermedio.add("NEWLINE", "-", "-", "-");
               :}
             ;

output_list ::= output_value:v
                {:
                    codigoIntermedio.add("WRITE", v.place, "-", "-");
                :}
                output_tail
              ;

output_tail ::= COMMA output_value:v
                {:
                    codigoIntermedio.add("WRITE", v.place, "-", "-");
                :}
                output_tail
              | /* empty */
              ;

output_value ::= IDENTIFIER:id
                 {:
                     usarVariable(id, idleft, idright);
                     SymbolInfo s = tablaSimbolos.lookup(id);
                     RESULT = new ExprAttr(
                         s != null ? s.getType() : DataType.UNKNOWN,
                         s != null ? getIrName(s) : id
                     );
                 :}
               | array_access:a
                 {:
                     String t = codigoIntermedio.newTemp();
                     codigoIntermedio.add("ARRAY_LOAD", a.render(), "-", t);
                     RESULT = new ExprAttr(a.type, t);
                 :}
               | numeric_literal:n
                 {: RESULT = n; :}
               | MINUS numeric_literal:n
                 {: RESULT = emitUnary("NEG", n); :}
               | bool_literal:b
                 {: RESULT = b; :}
               | CHAR_LITERAL:v
                 {: RESULT = new ExprAttr(DataType.CHAR, v); :}
               | STRING_LITERAL:v
                 {: RESULT = new ExprAttr(DataType.STRING, v); :}
               ;

if_stmt ::= IF TILDE PIPE_L condition:c PIPE_R
            {:
                if (c.type != DataType.BOOL && c.type != null && c.type != DataType.UNKNOWN) {
                    errorSemantico(
                        "Error semántico: condición del 'if' debe ser booleana, se encontró " + c.type +
                        " en línea " + cleft
                    );
                }

                String elseLabel = codigoIntermedio.newLabel("if_else");
                String endLabel = codigoIntermedio.newLabel("if_end");
                ifLabels.push(new String[]{elseLabel, endLabel});

                codigoIntermedio.add("IF_FALSE", c.place, "-", elseLabel);
            :}
            block
            else_opt
            {:
                String[] labels = ifLabels.pop();
                codigoIntermedio.add("LABEL", "-", "-", labels[1]);
            :}
          ;

else_opt ::= ELSE TILDE
             {:
                 String[] labels = ifLabels.peek();
                 codigoIntermedio.add("GOTO", "-", "-", labels[1]);
                 codigoIntermedio.add("LABEL", "-", "-", labels[0]);
             :}
             block
           | /* empty */
             {:
                 String[] labels = ifLabels.peek();
                 codigoIntermedio.add("LABEL", "-", "-", labels[0]);
             :}
           ;

loop_enter ::= {: 
                    dentroDeLoop++;
                    String start = codigoIntermedio.newLabel("do_start");
                    String end = codigoIntermedio.newLabel("do_end");
                    loopLabels.push(new String[]{start, end});
                    breakLabels.push(end);
                    codigoIntermedio.add("LABEL", "-", "-", start);
                :} ;

loop_exit  ::= {: 
                    dentroDeLoop--;
                    loopLabels.pop();
                    breakLabels.pop();
                :} ;

do_while_stmt ::= DO TILDE loop_enter block TILDE WHILE TILDE PIPE_L condition:c PIPE_R BANG
                  {:
                      if (c.type != DataType.BOOL && c.type != null && c.type != DataType.UNKNOWN) {
                          errorSemantico(
                              "Error semántico: condición del 'while' debe ser booleana, se encontró " + c.type +
                              " en línea " + cleft
                          );
                      }

                      String[] labels = loopLabels.peek();
                      codigoIntermedio.add("IF_TRUE", c.place, "-", labels[0]);
                      codigoIntermedio.add("LABEL", "-", "-", labels[1]);
                  :}
                  loop_exit
                ;

switch_stmt ::= SWITCH TILDE PIPE_L expression:e PIPE_R TILDE
                {:
                    if (e != null && e.type != DataType.INT && e.type != DataType.CHAR && e.type != DataType.UNKNOWN) {
                        errorSemantico(
                            "Error semántico: expresión del 'switch' debe ser de tipo INT o CHAR, se encontró " + e.type +
                            " en línea " + eleft
                        );
                    }
                    
                    String endLabel = codigoIntermedio.newLabel("switch_end");
                    String matchedName = codigoIntermedio.newLabel("switch_match");

                    breakLabels.push(endLabel);
                    switchStack.push(new SwitchState(e, endLabel, matchedName));

                    codigoIntermedio.add("ASSIGN", "false", "-", matchedName);
                :}

                BLOCK_OPEN switch_stmt_body BLOCK_CLOSE
                {:
                    SwitchState sw = switchStack.pop();
                    codigoIntermedio.add("LABEL", "-", "-", sw.endLabel);
                    breakLabels.pop();
                :}
              ;

switch_stmt_body ::= switch_body
                   | error
                   ;

switch_body ::= case_list default_opt ;

case_list ::= case_section case_list
            | /* empty */
            ;

case_section ::= CASE TILDE case_constant:k TILDE
                 {:
                     SwitchState sw = switchStack.peek();

                     String bodyLabel = codigoIntermedio.newLabel("switch_case_body");
                     String nextLabel = codigoIntermedio.newLabel("switch_case_next");

                     sw.nextCaseLabel = nextLabel;

                     codigoIntermedio.add("IF_TRUE", sw.matchedName, "-", bodyLabel);

                     ExprAttr cmp = emitBinary("EQ", sw.control, k);
                     codigoIntermedio.add("IF_FALSE", cmp.place, "-", nextLabel);

                     codigoIntermedio.add("LABEL", "-", "-", bodyLabel);

                     codigoIntermedio.add("ASSIGN", "true", "-", sw.matchedName);
                 :}

                 block
                 {:
                     SwitchState sw = switchStack.peek();
                     codigoIntermedio.add("LABEL", "-", "-", sw.nextCaseLabel);
                     sw.nextCaseLabel = null;
                 :}
                 ;

default_opt ::= DEFAULT TILDE block
              | /* empty */
              ;

case_constant ::= INTEGER_LITERAL:v
                  {: RESULT = new ExprAttr(DataType.INT, v); :}
                | FLOAT_LITERAL:v
                  {: RESULT = new ExprAttr(DataType.FLOAT, v); :}
                | SCIENTIFIC_LITERAL:v
                  {: RESULT = new ExprAttr(DataType.SCIENTIFIC, v); :}
                | FRACTION_LITERAL:v
                  {: RESULT = new ExprAttr(DataType.FRAC, v); :}
                | CHAR_LITERAL:v
                  {: RESULT = new ExprAttr(DataType.CHAR, v); :}
                | bool_literal:b
                  {: RESULT = b; :}
                ;

return_stmt ::= RETURN:r TILDE expression:e
                {:
                    currentFunctionHasReturn = true;
                    if (currentFunction != null && e != null && e.type != DataType.UNKNOWN) {
                        if (!tiposCompatibles(currentFunction.getType(), e.type)) {
                            errorSemantico(
                                "Error semántico: tipo de retorno incompatible en función '" +
                                currentFunction.getLexeme() + "', se esperaba " +
                                currentFunction.getType() + " pero se encontró " + e.type +
                                " en línea " + rleft
                            );
                        }
                    }

                    codigoIntermedio.add("RETURN", e.place, "-", "-");
                :}
              ;

break_stmt ::= BREAK:b
               {:
                   boolean contextoValido = (dentroDeLoop > 0) || !switchStack.isEmpty();

                   if (!contextoValido) {
                       errorSemantico(
                           "Error semántico: 'break' solo puede usarse dentro de 'do-while' o 'switch' en línea " + bleft
                       );
                   }

                   if (!breakLabels.isEmpty()) {
                       codigoIntermedio.add("GOTO", "-", "-", breakLabels.peek());
                   }
               :}
             ;

expression ::= bool_expr:b   {: RESULT = b; :}
             | num_expr:n    {: RESULT = n; :}
             | string_expr:s {: RESULT = s; :}
             | char_expr:c   {: RESULT = c; :}
             ;

condition ::= bool_expr:b
              {: RESULT = b; :}
            | reference_expr:r
              {: RESULT = r; :}
            ;

reference_expr ::= IDENTIFIER:id
                   {:
                       usarVariable(id, idleft, idright);
                       SymbolInfo s = tablaSimbolos.lookup(id);
                       RESULT = new ExprAttr(
                           s != null ? s.getType() : DataType.UNKNOWN,
                           s != null ? getIrName(s) : id
                       );
                   :}
                 | call_expr:c
                   {: RESULT = c; :}
                 ;

bool_expr ::= bool_chain:b
              {: RESULT = b; :}
            ;

bool_chain ::= conj_term:c bool_chain_tail:t
               {: RESULT = fold(c, t); :}
             ;

bool_chain_tail ::= OR conj_term:c bool_chain_tail:t
                    {:
                        t.add(0, new Step("OR", c));
                        RESULT = t;
                    :}
                  | /* empty */
                    {: RESULT = new java.util.ArrayList(); :}
                  ;

conj_term ::= bool_unit:b conj_term_tail:t
              {: RESULT = fold(b, t); :}
            ;

conj_term_tail ::= AND bool_unit:b conj_term_tail:t
                   {:
                       t.add(0, new Step("AND", b));
                       RESULT = t;
                   :}
                 | /* empty */
                   {: RESULT = new java.util.ArrayList(); :}
                 ;

bool_unit ::= NOT bool_unit:b
              {: RESULT = emitUnary("NOT", b); :}
            | bool_atom:a
              {: RESULT = a; :}
            ;

bool_atom ::= bool_literal:b
              {: RESULT = b; :}
            | rel_expr:r
              {: RESULT = r; :}
            | PIPE_L bool_expr:e PIPE_R
              {: RESULT = e; :}
            ;

rel_expr ::= EQUAL PIPE_L eq_operand:a COMMA eq_operand:b PIPE_R
             {:
                 if (a.type != null && b.type != null &&
                     a.type != DataType.UNKNOWN && b.type != DataType.UNKNOWN &&
                     !sonMismoGrupo(a.type, b.type)) {
                     errorSemantico(
                         "Error semántico: operandos de 'equal' deben ser del mismo tipo, se encontró " +
                         a.type + " y " + b.type + " en línea " + aleft
                     );
                 }
                 RESULT = emitBinary("EQ", a, b);
             :}
           | N_EQUAL PIPE_L eq_operand:a COMMA eq_operand:b PIPE_R
             {:
                 if (a.type != null && b.type != null &&
                     a.type != DataType.UNKNOWN && b.type != DataType.UNKNOWN &&
                     !sonMismoGrupo(a.type, b.type)) {
                     errorSemantico(
                         "Error semántico: operandos de 'n_equal' deben ser del mismo tipo, se encontró " +
                         a.type + " y " + b.type + " en línea " + aleft
                     );
                 }
                 RESULT = emitBinary("NE", a, b);
             :}
           | LESS_T PIPE_L num_expr:a COMMA num_expr:b PIPE_R
            {:
                if (!esNumerico(a.type) || !esNumerico(b.type)) {
                    errorSemantico(
                        "Error semántico: operandos de 'less_t' deben ser numéricos, se encontró " +
                        a.type + " y " + b.type + " en línea " + aleft
                    );
                }
                RESULT = emitBinary("LT", a, b);
            :}
            | LESS_TE PIPE_L num_expr:a COMMA num_expr:b PIPE_R
            {:
                if (!esNumerico(a.type) || !esNumerico(b.type)) {
                    errorSemantico(
                        "Error semántico: operandos de 'less_te' deben ser numéricos, se encontró " +
                        a.type + " y " + b.type + " en línea " + aleft
                    );
                }
                RESULT = emitBinary("LE", a, b);
            :}
            | GREATHER_T PIPE_L num_expr:a COMMA num_expr:b PIPE_R
            {:
                if (!esNumerico(a.type) || !esNumerico(b.type)) {
                    errorSemantico(
                        "Error semántico: operandos de 'greather_t' deben ser numéricos, se encontró " +
                        a.type + " y " + b.type + " en línea " + aleft
                    );
                }
                RESULT = emitBinary("GT", a, b);
            :}
            | GREATHER_TE PIPE_L num_expr:a COMMA num_expr:b PIPE_R
            {:
                if (!esNumerico(a.type) || !esNumerico(b.type)) {
                    errorSemantico(
                        "Error semántico: operandos de 'greather_te' deben ser numéricos, se encontró " +
                        a.type + " y " + b.type + " en línea " + aleft
                    );
                }
                RESULT = emitBinary("GE", a, b);
            :}
           ;

eq_operand ::= num_expr:n  {: RESULT = n; :}
             | bool_expr:b {: RESULT = b; :}
             ;

bool_literal ::= TRUE
                 {: RESULT = new ExprAttr(DataType.BOOL, "true"); :}
               | FALSE
                 {: RESULT = new ExprAttr(DataType.BOOL, "false"); :}
               ;

num_expr ::= sum_stage:s
             {: RESULT = s; :}
           ;

sum_stage ::= prod_stage:p sum_tail:t
              {:
                  for (Object obj : t) {
                      Step s = (Step) obj;
                      if (p.type != null && s.expr.type != null &&
                          p.type != DataType.UNKNOWN && s.expr.type != DataType.UNKNOWN &&
                          !tiposCompatibles(p.type, s.expr.type)) {
                          errorSemantico(
                              "Error semántico: operandos de '" + s.op + "' deben ser del mismo tipo, " +
                              "se encontró " + p.type + " y " + s.expr.type + " en línea " + pleft
                          );
                      }
                  }
                  RESULT = fold(p, t);
              :}
            ;

sum_tail ::= PLUS prod_stage:p sum_tail:t
             {:
                 if (!esNumerico(p.type)) {
                     errorSemantico(
                         "Error semántico: operando de '+' no es numérico, se encontró " + p.type +
                         " en línea " + pleft
                     );
                 }
                 t.add(0, new Step("+", p));
                 RESULT = t;
             :}
           | MINUS prod_stage:p sum_tail:t
             {:
                 if (!esNumerico(p.type)) {
                     errorSemantico(
                         "Error semántico: operando de '-' no es numérico, se encontró " + p.type +
                         " en línea " + pleft
                     );
                 }
                 t.add(0, new Step("-", p));
                 RESULT = t;
             :}
           | /* empty */
             {: RESULT = new java.util.ArrayList(); :}
           ;

prod_stage ::= power_stage:p prod_tail:t
               {:
                   for (Object obj : t) {
                       Step s = (Step) obj;
                       if (p.type != null && s.expr.type != null &&
                           p.type != DataType.UNKNOWN && s.expr.type != DataType.UNKNOWN &&
                           !tiposCompatibles(p.type, s.expr.type)) {
                           errorSemantico(
                               "Error semántico: operandos de '" + s.op + "' deben ser del mismo tipo, " +
                               "se encontró " + p.type + " y " + s.expr.type + " en línea " + pleft
                           );
                       }
                   }
                   RESULT = fold(p, t);
               :}
             ;

prod_tail ::= TIMES power_stage:p prod_tail:t
              {:
                  if (!esNumerico(p.type)) {
                      errorSemantico(
                          "Error semántico: operando de '*' no es numérico, se encontró " + p.type +
                          " en línea " + pleft
                      );
                  }
                  t.add(0, new Step("*", p));
                  RESULT = t;
              :}
            | DIV power_stage:p prod_tail:t
              {:
                  if (!esNumerico(p.type)) {
                      errorSemantico(
                          "Error semántico: operando de '/' no es numérico, se encontró " + p.type +
                          " en línea " + pleft
                      );
                  }
                  t.add(0, new Step("/", p));
                  RESULT = t;
              :}
            | MOD power_stage:p prod_tail:t
              {:
                  if (p.type != DataType.INT && p.type != DataType.UNKNOWN) {
                      errorSemantico(
                          "Error semántico: operando de '%' debe ser de tipo INT, se encontró " + p.type +
                          " en línea " + pleft
                      );
                  }
                  t.add(0, new Step("%", p));
                  RESULT = t;
              :}
            | /* empty */
              {: RESULT = new java.util.ArrayList(); :}
            ;
power_stage ::= prefix_stage:p POW power_stage:pw
                {:
                    if (p.type != DataType.INT && p.type != DataType.UNKNOWN) {
                        errorSemantico(
                            "Error semántico: base de '^' debe ser de tipo INT, se encontró " + p.type +
                            " en línea " + pleft
                        );
                    }
                    if (pw.type != DataType.INT && pw.type != DataType.UNKNOWN) {
                        errorSemantico(
                            "Error semántico: exponente de '^' debe ser de tipo INT, se encontró " + pw.type +
                            " en línea " + pwleft
                        );
                    }
                    RESULT = emitBinary("POW", p, pw);
                :}
              | prefix_stage:p
                {: RESULT = p; :}
              ;

prefix_stage ::= MINUS negative_literal:n
                 {:
                     RESULT = emitUnary("NEG", n);
                 :}
               | INC incrementable:i
                 {:
                     ExprAttr temp = emitUnary("INC", i);
                     codigoIntermedio.add("ASSIGN", temp.place, "-", i.place);
                     RESULT = temp;
                 :}
               | DEC incrementable:i
                 {:
                     ExprAttr temp = emitUnary("DEC", i);
                     codigoIntermedio.add("ASSIGN", temp.place, "-", i.place);
                     RESULT = temp;
                 :}
               | num_atom:n
                 {:
                     RESULT = n;
                 :}
               ;

num_atom ::= numeric_literal:n
             {: RESULT = n; :}
           | reference_expr:r
             {: RESULT = r; :}
           | array_access:a
             {:
                 String t = codigoIntermedio.newTemp();
                 codigoIntermedio.add("ARRAY_LOAD", a.render(), "-", t);
                 RESULT = new ExprAttr(a.type, t);
             :}
           | PIPE_L num_expr:e PIPE_R
             {: RESULT = e; :}
           ;

incrementable ::= IDENTIFIER:id
                  {:
                      SymbolInfo s = tablaSimbolos.lookup(id);
                      RESULT = new ExprAttr(
                          s != null ? s.getType() : DataType.UNKNOWN,
                          s != null ? getIrName(s) : id
                      );
                  :}
                  ;

negative_literal ::= INTEGER_LITERAL:v
                     {: RESULT = new ExprAttr(DataType.INT, v); :}
                   | FLOAT_LITERAL:v
                     {: RESULT = new ExprAttr(DataType.FLOAT, v); :}
                   | SCIENTIFIC_LITERAL:v
                     {: RESULT = new ExprAttr(DataType.SCIENTIFIC, v); :}
                   | FRACTION_LITERAL:v
                     {: RESULT = new ExprAttr(DataType.FRAC, v); :}
                   ;

numeric_literal ::= INTEGER_LITERAL:v
                    {: RESULT = new ExprAttr(DataType.INT, v); :}
                  | FLOAT_LITERAL:v
                    {: RESULT = new ExprAttr(DataType.FLOAT, v); :}
                  | SCIENTIFIC_LITERAL:v
                    {: RESULT = new ExprAttr(DataType.SCIENTIFIC, v); :}
                  | FRACTION_LITERAL:v
                    {: RESULT = new ExprAttr(DataType.FRAC, v); :}
                  ;

string_expr ::= STRING_LITERAL:v
                {: RESULT = new ExprAttr(DataType.STRING, v); :}
              ;

char_expr ::= CHAR_LITERAL:v
              {: RESULT = new ExprAttr(DataType.CHAR, v); :}
            ;
